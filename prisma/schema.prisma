// Prisma Database Schema for ELEVATE APPAREL
// Supports both MySQL and SQLite database backends

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  passwordHash  String?
  googleId      String?
  role          String      @default("CUSTOMER") // CUSTOMER | ADMIN
  phone         String?
  avatar        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  cart          Cart?
}

model Admin {
  id           String   @id @default(uuid())
  adminId      String   @unique // Unique Admin ID e.g. ADMIN-9901
  name         String
  email        String   @unique
  passwordHash String
  superAdmin   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique // Men, Women, Kids, Shirts, T-Shirts, Jeans, Shoes, Accessories
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  description    String
  price          Float
  originalPrice  Float
  discountPercent Int           @default(0)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  inStock        Boolean        @default(true)
  stockQuantity  Int            @default(10)
  highlights     String // JSON string array of key highlights
  specifications String // JSON string key-value pairs
  deliveryInfo   String?
  returnPolicy   String?        @default("7 Days Easy Return & Exchange")
  featured       Boolean        @default(false)
  isNewArrival   Boolean        @default(true)
  images         ProductImage[]
  colors         ProductColor[]
  sizes          ProductSize[]
  inventories    Inventory[]
  reviews        Review[]
  wishlists      Wishlist[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
}

model ProductColor {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. Midnight Black, Navy Blue, Crimson
  hexCode   String   // e.g. #000000, #000080
}

model ProductSize {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeCode  String   // XS, S, M, L, XL, XXL
}

model Inventory {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String
  size          String
  stockQuantity Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine  String
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique // e.g. ELV-849201
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  customerName     String
  email            String
  phone            String
  shippingAddress  String      // Stringified JSON or formatted string
  totalAmount      Float
  discountAmount   Float       @default(0)
  taxAmount        Float       @default(0)
  shippingFee      Float       @default(0)
  status           String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus    String      @default("UNPAID")  // UNPAID, PAID, FAILED, REFUNDED
  razorpayOrderId  String?
  razorpayPaymentId String?
  items            OrderItem[]
  payment          Payment?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productTitle String
  productImage String
  color        String?
  size         String?
  quantity     Int
  unitPrice    Float
  totalPrice   Float
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String   // RAZORPAY, COD, CARD, UPI
  transactionId String?
  amount        Float
  status        String   // SUCCESS, PENDING, FAILED
  payload       String?  // JSON gateway log
  createdAt     DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  userAvatar String?
  rating    Int      // 1 to 5
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemsJson String   // JSON serialized cart items
  updatedAt DateTime @updatedAt
}

model ThemeSettings {
  id             String   @id @default("default")
  themeName      String   @default("Elevate Indigo")
  primaryColor   String   @default("#4f46e5")
  primaryHover   String   @default("#4338ca")
  headerBg       String   @default("#0f172a")
  footerBg       String   @default("#0f172a")
  cardBg         String   @default("#ffffff")
  accentColor    String   @default("#f59e0b")
  borderRadius   String   @default("0.75rem")
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // LOW_STOCK, NEW_ORDER, REVENUE_ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
